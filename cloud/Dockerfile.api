FROM python:3.12-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /opt/heyaa
COPY cloud/requirements-api.txt /opt/heyaa/cloud/requirements-api.txt
RUN python -m pip install --upgrade pip \
    && python -m pip install -r cloud/requirements-api.txt

COPY src/ /opt/heyaa/src/
COPY cloud/ /opt/heyaa/cloud/

EXPOSE 8080
CMD ["uvicorn", "cloud.api:app", "--host", "0.0.0.0", "--port", "8080"]
