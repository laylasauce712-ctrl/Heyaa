# LOCAL DEVELOPMENT ONLY. Replace the API token before use.
# Do not expose this compose stack directly to the public internet.
HEYAA_CLOUD_API_TOKEN=dev-only-change-this-token-to-a-random-64-character-value
HEYAA_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
# Bind services to localhost by default. Use 0.0.0.0 only for deliberate LAN testing.
HEYAA_API_BIND_ADDRESS=127.0.0.1
HEYAA_STORAGE_BIND_ADDRESS=127.0.0.1

POSTGRES_DB=heyaa
POSTGRES_USER=heyaa
POSTGRES_PASSWORD=change-this-local-db-password
HEYAA_DATABASE_URL=postgresql://heyaa:change-this-local-db-password@db:5432/heyaa

MINIO_ROOT_USER=heyaa-local
MINIO_ROOT_PASSWORD=change-this-local-minio-password
HEYAA_STORAGE_ENDPOINT_URL=http://minio:9000
# Browser-facing URL embedded in presigned upload/preview/download URLs.
# Change localhost to the laptop's LAN IP when testing from a phone on the same Wi-Fi.
HEYAA_STORAGE_PUBLIC_ENDPOINT_URL=http://localhost:9000
HEYAA_STORAGE_REGION=us-east-1
HEYAA_STORAGE_BUCKET=heyaa-media
HEYAA_STORAGE_ACCESS_KEY=heyaa-local
HEYAA_STORAGE_SECRET_KEY=change-this-local-minio-password

# Local compose defaults to AI OFF. Set to 1 only when the API and worker
# are both deployed with a verified hardware-backed Vulkan GPU worker.
HEYAA_ENABLE_AI_UPSCALE=0
